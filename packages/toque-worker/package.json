{
  "name": "@toque/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Toque Worker + Container — authenticated Nusuk API gateway",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nusuk": "../../bin/nusuk.js"
  },
  "exports": {
    ".": "../../src/nusuk.js"
  },
  "scripts": {
    "test": "node --test ../../test/*.test.js",
    "check": "node --check ../../bin/nusuk.js && node --check ../../src/*.js && node --check ../../reqTook.js && node --check ../../senReq.js",
    "container": "node ../../src/server.js",
    "dev": "npx wrangler dev",
    "deploy": "../../scripts/deploy.sh",
    "deploy:dev": "../../scripts/deploy.sh --dev",
    "deploy:build-only": "../../scripts/deploy.sh --build-only",
    "deploy:rollback": "../../scripts/deploy.sh --rollback"
  },
  "dependencies": {
    "@toque/shared": "file:../shared",
    "@cloudflare/containers": "^0.3.7",
    "@zennolab_com/capmonstercloud-client": "^2.8.0",
    "cloakbrowser": "^0.5.6",
    "dotenv": "^17.2.3",
    "jose": "^6.2.8",
    "playwright-core": "^1.62.0"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
